package exercicio;

import java.util.Scanner;

public class cfbxdf {

	public static void main(String[] args) {
		 Scanner tc = new Scanner(System.in);

	        int numero;
	        int contadorPares = 0;
	        int somaPares = 0;
	        int somaImpares = 0;
	        int contadorImpares = 0;
	        double mediaImpares;

	        while (contadorPares < 10) {
	            System.out.println("Digite um número:");
	            numero = tc.nextInt();

	            if (numero % 2 == 0) {
	                contadorPares++;
	                somaPares += numero;
	            } else {
	                somaImpares += numero;
	                contadorImpares++;
	            }
	        }

	        // cálculo da média dos ímpares \\
	        if (contadorImpares > 0) {
	            mediaImpares = (double) somaImpares / contadorImpares;
	        } else {
	            mediaImpares = 0;
	        }

	        System.out.println("Soma dos números pares: " + somaPares);
	        System.out.println("Média dos números ímpares: " + mediaImpares);

	        tc.close();
	    }
	}

