package exercicio;

import java.util.Scanner;

public class ListaLPA {

	public static void main(String[] args) {
		double valorA, valorB, valorC, total;
		Scanner teclado = new Scanner(System.in);
		System.out.println("Adicione a seguir os valores de A, B, C :");
		valorA = teclado.nextDouble();
		valorB = teclado.nextDouble();
		valorC = teclado.nextDouble();
		total = valorA + valorB;
		if (total < valorC) {
			System.out.println("O valor de " + total + " é menor que " + valorC );
		}else { 
			if (total == valorC) {
			System.out.println("O valor de " + total + " é igual que " + valorC);
		}else {
			System.out.println("O valor de " + total + " é maior que " + valorC);}
		}
		
	}

}


