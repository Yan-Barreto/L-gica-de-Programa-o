		int[] v1;
		v1 = new int[5];
		for( int x=0 ; x<5 ; x++) {
			System.out.println("Digite a seguir os 5 valores do primeiro vetor:");
			v1[x]= tc.nextInt();
		}
		
		inverso(v1);
	}
       
	
	//e, em seguida, mostre os valores na ordem inversa da que foram digitados.
	public static void inverso( int[]v1) {
		 for( int x=4 ; x<=4 && x>-1 ; x--) {
			 System.out.println(v1[x]);
