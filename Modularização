public class cfbxdf {

    public static void main(String[] args) {
        Scanner tc = new Scanner(System.in);
        int quantidade;
        char linha;
        System.out.println("Digite a seguir o caracter e a quantidade de vezes que você quer que ele apareça: ");
        linha = tc.next().charAt(0);
        quantidade = tc.nextInt();
        desenharLinha(quantidade, linha);
    }
    
    public static void desenharLinha(int quantidade , char linha) {
    	for ( int i = 0 ; i < quantidade ; i++) {
    		System.out.print(linha);
    	}
    }
}
