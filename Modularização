        	 }
        
    public static int encontrarMaior (int num1, int num2, int num3) {
    	int maior = 0;
    	if ( num1 > num2 && num1 > num3) {
    		maior = num1;
    	} else {
    		if ( num2 > num1 && num2 > num3) {
    			maior = num2;
    		} else {
    			if ( num3 > num2 && num3 > num1) {
    				maior = num3;
    			}
    		}
    	}
    	return maior ;
  }
}




