TRABALO1

JMP start

aprovado:  DB "Aprovado"
           DB 0

reprovado: DB "Reprovado"
           DB 0
start:
.notas:
    MOV A, 6
    MOV B, 5
  
    ADD A, B
    MOV B, 2
    DIV B
    MOV B, 6
    SUB A, B
  
   JC .reprovado

.resultados:
.aprovado:
    MOV A, aprovado
    MOV D, 232
    CALL print
    HLT

.reprovado:
    MOV A, reprovado
    MOV D, 232
    CALL print
    JMP .notas

print:
    PUSH A
    PUSH B
    MOV B, 0

.loop:
    MOV A, [C]
    MOV [D], A
    INC C
    INC D
    CMP B, [C]
    JNZ .loop

    POP B
    POP A
    RET




TRABALHO 2

JMP inicio

; ===== MENSAGENS =====

A1: DB 'A'
A2: DB 'N'
A3: DB 'O'
A4: DB ':'

N1: DB 'N'
N2: DB 'O'
N3: DB 'M'
N4: DB 'E'
N5: DB ':'

; ===== VARIAVEIS =====

anonasc: DB 0
nome: DB 0
idade: DB 0

anoatual: DB 25

inicio:

; ===== ESCREVE ANO =====

MOV A, [A1]
MOV [232], A

MOV A, [A2]
MOV [232], A

MOV A, [A3]
MOV [232], A

MOV A, [A4]
MOV [232], A

; ===== LE ANO =====

MOV A, [231]

MOV [anonasc], A

; ===== ESCREVE NOME =====

MOV A, [N1]
MOV [232], A

MOV A, [N2]
MOV [232], A

MOV A, [N3]
MOV [232], A

MOV A, [N4]
MOV [232], A

MOV A, [N5]
MOV [232], A

; ===== LE NOME =====

MOV A, [231]

MOV [nome], A

; ===== CALCULO =====

MOV A, [anoatual]

SUB A, [anonasc]

MOV [idade], A

; ===== RESULTADO =====

MOV A, [nome]

MOV [232], A

MOV A, ' '

MOV [232], A

MOV A, [idade]

ADD A, '0'

MOV [232], A

HLT
