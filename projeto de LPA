    public static void exibirMenu(Scanner sc, Random sorteio, String[] frutas, String[] animais, String[] paises, String[] profissoes, String[] capitais) {

        int opcao, nivel, erroMax;

        do {
            System.out.println("JOGO DA FORCA");
            System.out.println("INFORME A OPÇÃO DESEJADA:");
            System.out.println("1 - JOGAR");
            System.out.println("2 - FECHAR O JOGO");
            opcao = sc.nextInt();

            switch (opcao) {
                case 1:
                    System.out.println("INFORME O NÍVEL QUE DESEJA JOGAR:");
                    System.out.println("1 - FÁCIL");
                    System.out.println("2 - MÉDIO");
                    System.out.println("3 - DIFÍCIL");
                    nivel = sc.nextInt();

                    switch (nivel) {
                        case 1:
                            erroMax = 10;
