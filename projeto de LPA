                        case 2:
                            erroMax = 8;
                            System.out.println("nível médio selecionado!");
                            break;

                        case 3:
                            erroMax = 6;
                            System.out.println("Nível difícil selecionado");
                            break;

                        default:
                            erroMax = 0;
                            System.out.println("Opção inválida!");
                            break;
                    }

                    String palavra = sortearCategoria(sorteio, frutas, animais, paises, profissoes, capitais, nivel);

                    jogar(sc, palavra, erroMax);

                    break;

                case 2:
                    System.out.println("Fechando o jogo...");
                    break;

                default:
                    System.out.println("Opção inválida");
            }
        } while(opcao != 2);
    }

    public static boolean verificarDificuldade(String palavra, int nivel) {

        int tamanhoPalavra = palavra.length();

        if (nivel == 1 && tamanhoPalavra <= 5) {
            return true;
        }
        else if (nivel == 2 && tamanhoPalavra >= 6 && tamanhoPalavra <= 8) {
            return true;
        }
        else if (nivel == 3 && tamanhoPalavra >= 9) {
            return true;
        }
        return false;
    }

    public static String sortearPalavra(Random sorteio, String[] categoria, int nivel) {

        String palavra;

        do {

            int posicao = sorteio.nextInt(categoria.length);
            palavra = categoria[posicao];

        }while (!verificarDificuldade(palavra, nivel));

        return palavra;
    }

    public static String sortearCategoria(Random sorteio, String[] frutas, String[] animais, String[] paises, String[] profissoes, String[] capitais, int nivel) {

        int categoria = sorteio.nextInt(5);

        if (categoria == 0) {
            System.out.println("CATEGORIA: FRUTAS");
            return sortearPalavra(sorteio, frutas, nivel);
        }
        else if (categoria == 1) {
            System.out.println("CATEGORIA: ANIMAIS");
            return sortearPalavra(sorteio, animais, nivel);
        }
        else if (categoria == 2) {
            System.out.println("CATEGORIA: PAÍSES");
            return sortearPalavra(sorteio, paises, nivel);
        }
        else if (categoria == 3) {
            System.out.println("CATEGORIA: PROFISSÕES");
            return sortearPalavra(sorteio, profissoes, nivel);
        }
        else {
            System.out.println("CATEGORIA: CAPITAL MUNDIAL");
            return sortearPalavra(sorteio, capitais, nivel);
        }
    }

    public static boolean validarJogada(char letra, String palavra, char[] exibirPalavra) {

        boolean encontrou = false;

        for (int i = 0; i < palavra.length(); i++) {
            if (palavra.charAt(i) == letra) {

                exibirPalavra[i] = letra;

                encontrou = true;
            }
        }
        return encontrou;
    }

    public static boolean validarTriunfo(char[] exibirPalavra) {

        for (int i = 0; i < exibirPalavra.length; i++) {
            if (exibirPalavra[i] == '_') {
                return false;
            }
        }
        return true;
    }

    public static void mostrarPalavra(char[] exibirPalavra) {

        for (int i = 0; i < exibirPalavra.length; i++) {
            System.out.print(exibirPalavra[i] + " ");
        }

        System.out.println();
    }

    public static void desenharForca(int erros) {

        System.out.println(" +----+");
        System.out.println(" |    |");

        switch (erros) {

            case 0:
                System.out.println("      |");
                System.out.println("      |");
                System.out.println("      |");
                break;

            case 1:
                System.out.println(" O    |");
                System.out.println("      |");
                System.out.println("      |");
                break;

            case 2:
                System.out.println(" O    |");
                System.out.println(" |    |");
                System.out.println("      |");
                break;

            case 3:
                System.out.println(" O    |");
                System.out.println("/|    |");
                System.out.println("      |");
                break;

            case 4:
                System.out.println(" O    |");
                System.out.println("/|\\   |");
                System.out.println("      |");
                break;

            case 5:
                System.out.println(" O    |");
                System.out.println("/|\\   |");
                System.out.println("/     |");
                break;

            default:
                System.out.println(" O    |");
                System.out.println("/|\\   |");
                System.out.println("/ \\   |");
                break;
        }

        System.out.println("      |");
        System.out.println("=========");
    }

    public static void jogar(Scanner sc, String palavra, int erroMax) {

        char exibirPalavra[] = new char[palavra.length()];
        char letrasUsadas[] = new char[50];

        int erros = 0, qtdLetrasUsadas = 0;

        for (int i = 0; i < exibirPalavra.length; i++) {

            char caractere = palavra.charAt(i);

            if(caractere == ' ' || caractere == '-') {
                exibirPalavra[i] = caractere;
            }
            else {
                exibirPalavra[i] = '_';
            }
        }

        while (erros < erroMax && !validarTriunfo(exibirPalavra)) {

            desenharForca(erros);
            mostrarPalavra(exibirPalavra);

            for (int i = 0; i < qtdLetrasUsadas; i++) {
                System.out.print(letrasUsadas[i] + " ");
            }

            System.out.println();
            System.out.println("Tentativas restantes: " + (erroMax - erros));

            System.out.println("Digite uma letra: ");
            char letra = sc.next().toLowerCase().charAt(0);

            boolean repetida = false;

            for (int i = 0; i < qtdLetrasUsadas; i++) {

                if (letrasUsadas[i] == letra) {
                    repetida = true;
                }
            }

            if (repetida) {
                System.out.println("Essa letra já foi usada!");
            }
            else {
                letrasUsadas[qtdLetrasUsadas] = letra;
                qtdLetrasUsadas++;

                boolean acertou = validarJogada(letra, palavra, exibirPalavra);
                if (acertou) {
                    System.out.println("Você acertou a letra!");
                }
                else {
                    System.out.println("Você errou a letra!");
                    erros++;
                }
            }
        }

        System.out.println();

        if (validarTriunfo(exibirPalavra)) {
            System.out.println("PARABÉNS! VOCÊ GANHOU!");
        }
        else {
            desenharForca(erros);
            System.out.println("VOCÊ PERDEU!");
        }

        System.out.println("A palavra era: " + palavra);

    }
